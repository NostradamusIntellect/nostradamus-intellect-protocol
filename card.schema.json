{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/NostradamusIntellect/nostradamus-intellect-protocol/card.schema.json",
  "title": "Nostradamus Intellect card",
  "description": "One card of the public record, as served at https://nostradamusintellect.com/engine/cards/<id>.json. Ledger seals and sealed statements are graded; projections are not.",
  "type": "object",
  "required": ["id", "code", "kind", "title", "probability", "status", "url", "contract"],
  "properties": {
    "id": { "type": "string", "description": "Stable identifier, e.g. cal-12" },
    "code": { "type": "string", "description": "Public code, e.g. CAL-12, ZUC-01, TEC-04" },
    "kind": { "enum": ["ledger-seal", "sealed-statement", "projection"] },
    "scored": { "type": "boolean", "description": "false for projections: a narrative window, not a scored seal" },
    "title": { "type": "string", "description": "The sealed statement (ledger) or the card title" },
    "domain": { "type": ["string", "null"] },
    "probability": { "type": "number", "minimum": 0, "maximum": 100, "description": "Percent, as sealed. Never rewritten." },
    "confidence": { "type": ["number", "null"] },
    "sealed_on": { "type": ["string", "null"], "format": "date" },
    "resolve_by": { "type": ["string", "null"], "description": "YYYY-MM-DD (seals, statements) or the last year of the window (projections)" },
    "status": { "type": "string", "description": "PENDING until graded" },
    "resolution_criteria": { "type": ["string", "null"], "description": "What counts as correct — ledger seals and sealed statements" },
    "falsifiability": { "type": ["string", "null"], "description": "What would prove it wrong — projections and sealed statements" },
    "sealed": {
      "type": "object",
      "description": "Ledger seals only: exactly the stamped fields, in stamped order. SHA-256 of JSON.stringify(sealed) equals sha256.",
      "properties": {
        "id": { "type": "string" },
        "code": { "type": "string" },
        "domain": { "type": "string" },
        "statement": { "type": "string" },
        "probability": { "type": "number" },
        "sealedOn": { "type": "string" },
        "resolveBy": { "type": "string" },
        "status": { "type": "string" },
        "resolutionCriteria": { "type": "string" }
      }
    },
    "sealed_fields": { "type": "array", "items": { "type": "string" } },
    "sha256": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" },
    "ledger_root": { "type": ["string", "null"] },
    "timestamp_proof": { "type": ["string", "null"], "format": "uri", "description": "OpenTimestamps proof (.ots)" },
    "speaker": { "type": "string", "description": "Sealed statements: who said it" },
    "quote": { "type": "string", "description": "Sealed statements: the exact words" },
    "said_on": { "type": "string" },
    "venue": { "type": "string" },
    "receipts": { "type": "array", "items": { "type": "object", "properties": { "label": { "type": "string" }, "url": { "type": "string", "format": "uri" } } } },
    "restated": { "type": ["object", "null"] },
    "timeline": { "type": "string" },
    "horizon": { "type": ["string", "null"] },
    "uncertainty": { "type": ["string", "null"] },
    "trigger_events": { "type": "array", "items": { "type": "string" } },
    "url": { "type": "string", "format": "uri" },
    "contract": { "type": "object", "description": "The terms every card is published under" },
    "source": { "type": "string", "format": "uri" }
  }
}
